# ============================================================
#  alon-carpentry — .gitignore
#  הריפו הזה ציבורי. כל מה שנכנס לכאן נשאר בהיסטוריה לנצח,
#  גם אחרי מחיקה בקומיט הבא. לכן: סודות וקבצים כבדים לא נכנסים.
# ============================================================

# --- סודות ---------------------------------------------------
# הדרישה המפורשת. .env מכיל את ה-webhook של n8n ומפתחות Cloudinary.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
token.json
service-account*.json
.netrc

# --- קבצי מקור כבדים ----------------------------------------
# ה-PNG המקורי הוא 9.76MB. גיט לא דוחס בינאריים ולא מוחק גרסאות ישנות,
# אז כל שמירה מנפחת את הריפו לצמיתות. המקורות נשארים מקומית ב-_source/,
# מה שנפרס הוא רק הנכס המעובד ב-assets/.
_source/
*.psd
*.ai
*.sketch
*.fig
*.zip
*.mp4
*.mov

# --- תלויות ופלט בנייה --------------------------------------
node_modules/
dist/
build/
.cache/
.parcel-cache/
.vite/
.next/
.vercel
.netlify

# --- לוגים ---------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- מערכת הפעלה --------------------------------------------
# Windows יוצר את אלה בכל תיקייה שנפתחה בסייר. ללא זה הם נכנסים בטעות.
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
._*

# --- עורכים --------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# --- זמניים --------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
