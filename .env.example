# ============================================================
#  .env.example — תבנית. מותר בגיט.
#  להעתיק ל-.env ולמלא. .env עצמו חסום ב-.gitignore.
# ============================================================

# ה-webhook של n8n שמקבל את הטופס.
# מ-n8n: נוד Webhook > Production URL
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/xxxxxxxx-xxxx-xxxx

# הטלפון של אלון בפורמט בינלאומי, לקישור הוואטסאפ.
# 054-000-0000  ->  972540000000
WHATSAPP_NUMBER=972540000000

# ============================================================
#  ⚠️  קרא את זה. זה לא פרט טכני קטן.
# ============================================================
#
#  הדף הוא HTML סטטי. אין לו שרת, ולכן הוא לא יכול לקרוא
#  את הקובץ הזה. כתובת ה-webhook שתיכנס ל-index.html
#  תהיה גלויה לכל מי שיפתח "הצג מקור".
#
#  זה לא באג — זו המהות של דף סטטי. לא לנסות "להסתיר" אותה
#  בבסיס 64 או בפיצול מחרוזת; זה מסתיר רק מפניך.
#
#  הקובץ הזה הוא התיעוד: איפה הערכים האמיתיים יושבים,
#  כדי שלא יתגלגלו להיסטוריית גיט ציבורית.
#
#  מה כן מגן, בצד n8n (ראה docs/n8n-setup.md):
#    · Rate limit על ה-webhook
#    · בדיקת Origin — לקבל רק מהדומיין של הדף
#    · דחיית בקשות עם שדה company מלא (מלכודת הספאם)
#
# ============================================================
